# Optional configuration (load manually or with process manager)
PORT=3000
# Android WebView origin; add other explicitly trusted origins separated by commas
APP_ORIGINS=https://app.artymods.local
# Generated securely with: openssl rand -hex 32
ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Leave false in public production. Moderator approves files via admin API.
AUTO_APPROVE=false
